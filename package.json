{
  "name": "law-study",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --webpack --hostname 127.0.0.1",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build --webpack",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start --hostname 127.0.0.1",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "db:seed": "node --import tsx prisma/seed.ts",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "postinstall": "npm run db:generate",
    "db:generate": "node --import tsx scripts/generate.ts",
    "test:ui": "playwright test",
    "pretest:ui": "node --import tsx scripts/prepare-ui-test.ts",
    "db:ocr": "node --import tsx scripts/ocr.ts",
    "dev:phone": "vite --config mobile/vite.config.ts",
    "build:phone": "vite build --config mobile/vite.config.ts && node scripts/audit-phone-build.mjs",
    "preview:phone": "vite preview --config mobile/vite.config.ts",
    "test:phone": "playwright test --config playwright.phone.config.ts",
    "pretest:phone": "node --import tsx scripts/make-phone-fixture.ts && npm run build:phone"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/client": "7.10.1",
    "@types/better-sqlite3": "^9.6.0",
    "better-sqlite3": "^13.0.3",
    "dexie": "^4.4.7",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "lucide-react": "^0.577.0",
    "mammoth": "^1.11.0",
    "next": "^16.4.4",
    "pdfjs-dist": "^5.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@prisma/client-generator-registry": "7.10.1",
    "@prisma/internals": "7.10.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.2.1",
    "fake-indexeddb": "^6.2.7",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.9.10",
    "prisma": "7.10.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.0.0"
  },
  "type": "module"
}
